<!DOCTYPE html>
<html>
<head>
<title>Editar Producto</title>
<link rel="icon" type="image/png" href="/img/favicon.png">

<style>
    body {
    font-family: 'Segoe UI', sans-serif;
    background: #f4f6f9;
    margin:0;
}

    .navbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:#111;
    color:white;
    padding:8px 25px;
}

.logo img{
    height:45px;
    width:auto;
}

.titulo-navbar{
    font-size:22px;
    font-weight:700;
}

    .container {
    max-width: 400px;
    margin: 40px auto;
    background: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

    input, select {
    width: 100%;
    padding: 10px;
    margin: 10px 0;
    border-radius: 5px;
    border: 1px solid #ccc;
}

    button {
    width: 100%;
    padding: 10px;
    background: black;
    color: white;
    border: none;
    border-radius: 5px;
    margin-top: 10px;
}

.volver{
    display:inline-block;
    margin:15px;
    padding:8px 15px;
    background:black;
    color:white;
    text-decoration:none;
    border-radius:6px;
}

small{
display:block;
color:red;
font-size:13px;
margin-top:-4px;
margin-bottom:8px;
min-height:18px;
}
</style>
</head>

<body>

    <div class="navbar">

    <div class="logo">
        <img src="/img/logo.png">
    </div>

    <div class="titulo-navbar">
        Editar Producto
    </div>

    <div style="width:100px;"></div>

</div>

<a href="/admin/productos" class="volver">
    ← Volver a Productos
</a>

<div class="container">

    <h2>Editar Producto</h2>

    <form
action="/admin/productos/editar"
method="POST"
onsubmit="return validarEditarProducto()"
novalidate
>

        <input type="hidden" name="id" value="<%= producto.id %>">

        <input
type="text"
id="nombre"
name="nombre"
value="<%= producto.nombre %>">

<small id="errNombre"></small>

        <input
type="text"
id="descripcion"
name="descripcion"
value="<%= producto.descripcion %>">

<small id="errDescripcion"></small>

        <input
type="text"
id="precio"
name="precio"
value="<%= producto.precio %>">
<small id="errPrecio"></small>
       <select
id="categoria_id"
name="categoria_id">
            <option value="">Seleccione categoría</option>

            <% categorias.forEach(c => { %>
                <option value="<%= c.id %>" 
                    <%= producto.categoria_id == c.id ? 'selected' : '' %>>
                    <%= c.nombre %>
                </option>
            <% }) %>
        </select>
        <small id="errCategoria"></small>

        <input
type="text"
id="imagen"
name="imagen"
value="<%= producto.imagen %>">

<small id="errImagen"></small>

        <button type="submit">Guardar cambios</button>

    </form>

    <br>
</div>
<script>

function validarEditarProducto(){

let ok = true;

document.getElementById("errNombre").innerHTML="";
document.getElementById("errDescripcion").innerHTML="";
document.getElementById("errPrecio").innerHTML="";
document.getElementById("errCategoria").innerHTML="";
document.getElementById("errImagen").innerHTML="";

const nombre =
document.getElementById("nombre").value.trim();

const descripcion =
document.getElementById("descripcion").value.trim();

const precio =
document.getElementById("precio").value.replace(",", ".");

const categoria =
document.getElementById("categoria_id").value;

const imagen =
document.getElementById("imagen").value.trim();

if(nombre === ""){
document.getElementById("errNombre").innerHTML =
"Ingrese nombre";
ok = false;
}
else if(nombre.length < 3){
document.getElementById("errNombre").innerHTML =
"El nombre debe tener al menos 3 caracteres";
ok = false;
}

if(descripcion === ""){
document.getElementById("errDescripcion").innerHTML =
"Ingrese descripción";
ok = false;
}
else if(descripcion.length < 5){
document.getElementById("errDescripcion").innerHTML =
"La descripción debe tener al menos 5 caracteres";
ok = false;
}

if(precio === ""){
document.getElementById("errPrecio").innerHTML =
"Ingrese precio";
ok = false;
}
else if(parseFloat(precio) <= 0){
document.getElementById("errPrecio").innerHTML =
"El precio debe ser mayor que cero";
ok = false;
}

if(categoria === ""){
document.getElementById("errCategoria").innerHTML =
"Seleccione categoría";
ok = false;
}

if(imagen === ""){
document.getElementById("errImagen").innerHTML =
"Ingrese nombre de imagen";
ok = false;
}

return ok;

}

</script>
</body>
</html>