<!DOCTYPE html>
<html>
<head>
<title>Nuevo Producto</title>
<link rel="icon" type="image/png" href="/img/favicon.png">

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
        margin: 0;
    }

    /* NAVBAR */
    .navbar{
    display:flex;
    align-items:center;
    justify-content:space-between;

    background:#111;
    color:white;

    padding:8px 25px;
}

.logo img{
    height:45px;
    width:auto;
}

.titulo-navbar{
    font-size:22px;
    font-weight:700;
}

    /* CONTENEDOR */
    .container {
        max-width: 400px;
        margin: 40px auto;
        background: white;
        padding: 30px;
        border-radius: 10px;
    }

    /* INPUTS */
    input,
select,
textarea{
    width:100%;
    padding:10px;
    margin:10px 0;
    border-radius:5px;
    border:1px solid #ccc;
    box-sizing:border-box;
}

textarea{
    min-height:90px;
    resize:vertical;
}

    /* BOTÓN DE ACCIÓN */
    button {
        width: 100%;
        padding: 10px;
        background: black;
        color: white;
        border: none;
        border-radius: 5px;
        margin-top: 10px;
        cursor:pointer;
    }

    /* VOLVER */
    .volver {
        display: inline-block;
        margin: 15px;
        padding: 8px 15px;
        background: black;
        color: white;
        text-decoration: none;
        border-radius: 6px;
    }

    small{
display:block;
color:red;
font-size:13px;
margin-top:-5px;
margin-bottom:8px;
}

.volver:hover{
    background:#333;
}

button:hover{
    background:#333;
}
</style>
</head>

<body>

<div class="navbar">

    <div class="logo">
        <img src="/img/logo.png">
    </div>

    <div class="titulo-navbar">
        Agregar Producto
    </div>

    <div style="width:100px;"></div>

</div>

<a href="/admin/productos" class="volver">
    ← Volver a Productos
</a>

<div class="container">
    <h2>Nuevo ProductoClara</h2>

   <form
action="/admin/productos/guardar"
method="POST"
enctype="multipart/form-data"
onsubmit="return validarProducto()"
novalidate
>

        <input
type="text"
id="nombre"
name="nombre"
placeholder="Nombre">

<small id="errNombre"></small>


<textarea
id="descripcion"
name="descripcion"
placeholder="Descripción"></textarea>

<small id="errDescripcion"></small>


<input
type="number"
id="precio"
name="precio"
placeholder="Precio">

<small id="errPrecio"></small>


<select
id="categoria_id"
name="categoria_id">

    <option value="">Seleccione categoría</option>

    <% categorias.forEach(c => { %>
        <option value="<%= c.id %>">
            <%= c.nombre %>
        </option>
    <% }) %>

</select>

<small id="errCategoria"></small>


<input
type="file"
id="imagen"
name="imagen"
accept="image/*">

<small id="errImagen"></small>
       <button type="submit">Guardar</button>

    </form>
</div>
<script>

function validarProducto(){

let ok = true;

document.getElementById("errNombre").innerHTML="";
document.getElementById("errDescripcion").innerHTML="";
document.getElementById("errPrecio").innerHTML="";
document.getElementById("errCategoria").innerHTML="";
document.getElementById("errImagen").innerHTML="";

const nombre =
document.getElementById("nombre").value.trim();

const descripcion =
document.getElementById("descripcion").value.trim();

const precio =
document.getElementById("precio").value;

const categoria =
document.getElementById("categoria_id").value;

const imagen =
document.getElementById("imagen").value;

if(nombre === ""){
document.getElementById("errNombre").innerHTML =
"Ingrese nombre";
ok = false;
}

if(descripcion === ""){
document.getElementById("errDescripcion").innerHTML =
"Ingrese descripción";
ok = false;
}

if(precio === ""){
document.getElementById("errPrecio").innerHTML =
"Ingrese precio";
ok = false;
}
else if(parseFloat(precio) <= 0){
document.getElementById("errPrecio").innerHTML =
"El precio debe ser mayor que cero";
ok = false;
}

if(categoria === ""){
document.getElementById("errCategoria").innerHTML =
"Seleccione categoría";
ok = false;
}

if(imagen === ""){
document.getElementById("errImagen").innerHTML =
"Seleccione una imagen";
ok = false;
}

return ok;

}

</script>
</body>
</html>