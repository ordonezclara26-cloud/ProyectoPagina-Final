<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        background: #f5f5f5;
    }

    /* NAVBAR: Navegación completa para facilitar el salto entre departamentos */
    .navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 20px;
        background: #111;
        color: white;
        flex-wrap: wrap;
    }

    .logo img {
    height: 70px;
    width: auto;
}

    .nav-links {
        display: flex;
        flex-wrap: wrap;
    }

    .nav-links a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    font-size: 16px;
    margin-left: 25px;
}

    /* TITULO */
    h1 {
        text-align: center;
        margin-top: 20px;
    }

    /* SECCIÓN DE TEXTO: Introducción clara al servicio */
    .subtitulo {
        text-align: center;
        max-width: 750px;
        margin: 10px auto 20px;
        color: #555;
        font-size: 16px;
        padding: 0 15px;
    }

    /* GRID */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
        padding: 20px;
    }

    /* TARJETAS DE SERVICIO: Estilo oscuro para contrastar con el catálogo de productos */
    .card {
        background: #111;
        color: white;
        border-radius: 15px;
        padding: 15px;
        text-align: center;
    }

    .card img {
        width: 100%;
        height: 180px;
        object-fit: cover; /* Evita que la imagen se deforme al estirarse */
        border-radius: 10px;
    }

    .nombre {
        margin-top: 10px;
        font-weight: bold;
    }

    /* RESPONSIVE */
    @media (max-width: 768px) {

        .navbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .card img {
            height: 140px;
        }

        .footer-contenido{
    grid-template-columns: 1fr;
    gap:20px;
    }

    }

    /* FOOTER */

.footer{
    background:#111;
    color:white;

    margin-top:50px;
    padding:25px 30px 10px;
}

.footer-contenido{
    display:grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap:30px;
}

.footer-col p{
    margin:8px 0;
}

.footer-col{
    min-width:0;
}

.footer-col h3{
    margin-top:0;
    margin-bottom:15px;
    font-size:18px;
}

.footer-col a{
    display:block;
    color:#d9d9d9;
    text-decoration:none;
    margin-bottom:10px;
}

.footer-col a:hover{
    color:white;
}

.footer-col p a{
    color:white;
    text-decoration:none;
}

.footer-col p a{
    color:white;
    text-decoration:none;
}

.footer-copy{
    text-align:center;
    border-top:1px solid #333;
    margin-top:25px;
    padding-top:15px;
    color:#aaa;
    font-size:14px;
}
.btn-whatsapp{
