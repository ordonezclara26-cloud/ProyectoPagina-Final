<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finalizar Compra</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">

<style>
    body {
        font-family: Arial;
        margin: 0;
        background: #f4f6f9;
    }

    /* BARRA DE NAVEGACIÓN SIMPLIFICADA
       En el checkout se reducen los links para evitar que el usuario abandone la compra */
     .navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 20px;
        background: #111;
        color: white;
    }

    .logo{
    position:absolute;
    left:20px;
}

    .logo img {
    height: 45px;
    width: auto;
}

.titulo-navbar{
    font-size:24px;
    font-weight:bold;
}

    .container {
        max-width: 400px;
        margin: 50px auto;
        background: white;
        padding: 30px;
        border-radius: 10px;
    }

    /* CAMPOS DE ENTRADA: Diseño estandarizado para facilitar la escritura */
    input, select {
        width: 100%;
        padding: 10px;
        margin: 10px 0;
        border-radius: 5px;
        border: 1px solid #ccc;
    }

    /* BOTÓN DE ACCIÓN FINAL */
    .btn-pagar {
        width: 100%;
        padding: 12px;
        background: #16a34a;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }
</style>
</head>

<body>

<div class="navbar">
    <div class="logo">
        <img src="/img/logo.png">
    </div>

     <div class="titulo-navbar">
        Resumen del Pedido
    </div>

     <div></div>

</div>

<div class="container">

    <h2>Datos de Entrega</h2>

    <form action="/compra" method="POST">

        <input type="text" name="nombre" placeholder="Nombre completo" required>

        <input type="email" name="correo" placeholder="Correo electrónico" required>

        <input type="text" name="telefono" placeholder="Teléfono" required>

        <input type="text" name="direccion" placeholder="Dirección exacta" required>

        <select name="envio" required>

     <option value="" selected disabled>
        Seleccione destino
    </option>      

    <option value="juticalpa">
        Mandadito Juticalpa (L.60)
    </option>

    <option value="jutiquile">
        Mandadito Jutiquile (L.80)
    </option>

    <option value="catacamas">
        Mandadito Catacamas (L.120)
    </option>
</select>

<div id="resumen-total"
style="
background:#f8f9fa;
padding:15px;
border-radius:8px;
margin:10px 0;
">

    <p>
        Subtotal:
        <strong>L. <%= total %></strong>
    </p>

    <p>
        Envío:
        <strong id="costo-envio">L. 60</strong>
    </p>

    <p>
        Total estimado:
        <strong id="total-estimado">
            L. <%= total + 60 %>
        </strong>
    </p>

</div>

        <select name="metodo" required>
            <option value="contra_entrega">Pago contra entrega</option>

             <option value="transferencia">
        Transferencia bancaria
    </option>
        </select>

        <button class="btn-pagar">Confirmar pedido</button>

    </form>

</div>
<script>

const envio = document.querySelector('select[name="envio"]');

const subtotal = <%= total %>;

envio.addEventListener('change', () => {

    let costo = 0;

    if(envio.value === "juticalpa"){
        costo = 60;
    }

    if(envio.value === "jutiquile"){
        costo = 80;
    }

    if(envio.value === "catacamas"){
        costo = 120;
    }

    document.getElementById("costo-envio").innerText =
        "L. " + costo;

    document.getElementById("total-estimado").innerText =
        "L. " + (subtotal + costo);

});

</script>
</body>
</html>
