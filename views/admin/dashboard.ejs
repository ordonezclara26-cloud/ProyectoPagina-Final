<!DOCTYPE html>
<html>
<head>
    <title>Panel Admin</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">

<style>
    /* CONFIGURACIÓN DE PANTALLA */
    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    /* NAVBAR: Barra superior de estado */
    .navbar{
    display:flex;
    align-items:center;
    justify-content:space-between;

    background:#111;
    color:white;

    padding:8px 25px;
}

    .logo img{
    height:45px;
    width:auto;
}

.titulo-navbar{
    font-size:22px;
    font-weight:700;
}

    .navbar h2 {
        margin: 0;
        font-size: 18px;
    }

    .logout {
        color: white;
        text-decoration: none;
        font-size: 14px;
    }

    /* CONTENIDO */
    .container {
        padding: 30px;
    }

    /* TITULO */
    .title {
        margin-bottom: 20px;
    }

    /* GRID ADAPTATIVO (Dashboard Layout) */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
    }

    /* CARDS DE NAVEGACIÓN */
    .card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        text-align: center;
        transition: 0.3s;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        cursor: pointer;
    }

    /* Efecto de elevación al pasar el mouse */
    .card:hover {
        transform: translateY(-5px);
    }

    /* ICONOS */
    .icon {
        font-size: 35px;
        margin-bottom: 10px;
    }

    /* CÓDIGO DE COLORES (Identidad por Módulo) */
    .cat { background: #ff7a00; color: white; }
    .prod { background: #2563eb; color: white; }
    .ped { background: #16a34a; color: white; }
    .user { background: #9333ea; color: white; }

    .card h3 {
        margin: 0;
    }

    .mensaje-acceso{
    margin-top:25px;
    background:white;
    padding:15px;
    border-radius:10px;
    border-left:5px solid #9333ea;
    box-shadow:0 5px 15px rgba(0,0,0,0.1);
    display:none;
}
</style>
</head>

<body>

<!-- NAVBAR -->
<div class="navbar">

    <div class="logo">
        <img src="/img/logo.png">
    </div>

    <div class="titulo-navbar">
        Panel de Administración
    </div>

    <a href="/auth/logout" class="logout">
        Cerrar sesión
    </a>

</div>

<div class="container">

   <h2 class="title">Bienvenido al sistema</h2>

<% if(mensajeError){ %>

<div class="mensaje-acceso" style="display:block;">
    ⚠ <%= mensajeError %>
</div>

<% } %>

<div class="grid">

        <a href="/admin/categorias" style="text-decoration:none;">
            <div class="card cat">
                <div class="icon">📂</div>
                <h3>Categorías</h3>
            </div>
        </a>

        <a href="/admin/productos" style="text-decoration:none;">
            <div class="card prod">
                <div class="icon">💻</div>
                <h3>Productos</h3>
            </div>
        </a>

        <a href="/admin/pedidos" style="text-decoration:none;">
            <div class="card ped">
                <div class="icon">📦</div>
                <h3>Pedidos</h3>
            </div>
        </a>

        <% if(usuario && usuario.rol_id == 1){ %>

<a href="/admin/usuarios" style="text-decoration:none;">
    <div class="card user">
        <div class="icon">👤</div>
        <h3>Usuarios</h3>
    </div>
</a>

<% } else { %>

<a href="#"
   onclick="mostrarAcceso(); return false;"
   style="text-decoration:none;">

    <div class="card user">
        <div class="icon">👤</div>
        <h3>Usuarios</h3>
    </div>

</a>

<% } %>

    </div>

<div id="mensajeAcceso" class="mensaje-acceso">
    ⚠ Solo los administradores pueden gestionar usuarios.
</div>

</div>

<script>

function mostrarAcceso(){

    document.getElementById("mensajeAcceso").style.display =
    "block";

}

</script>

</body>

</html>
