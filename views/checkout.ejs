<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sico's - Resumen de Pedido</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">

<style>
    body {
        font-family: Arial;
        margin: 0;
        background: #f4f6f9;
    }

    /* BARRA DE NAVEGACIÓN SIMPLIFICADA
       En el checkout se reducen los links para evitar que el usuario abandone la compra */
     .navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 20px;
        background: #111;
        color: white;
    }

    .logo img {
    height: 45px;
    width: auto;
}

.titulo-navbar{
    font-size:28px;
    font-weight:bold;
    flex:1;
    text-align:center;
}

    .container {
        max-width: 400px;
        margin: 50px auto;
        background: white;
        padding: 30px;
        border-radius: 10px;
    }

    /* CAMPOS DE ENTRADA: Diseño estandarizado para facilitar la escritura */
    input, select {
        width: 100%;
        padding: 10px;
        margin: 10px 0;
        border-radius: 5px;
        border: 1px solid #ccc;
    }

    /* BOTÓN DE ACCIÓN FINAL */
    .btn-pagar {
        width: 100%;
        padding: 12px;
        background: #16a34a;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    small{
display:block;
color:red;
font-size:13px;
margin-top:-5px;
margin-bottom:8px;
min-height:18px;
}
</style>
</head>

<body>

<div class="navbar">

    <div class="logo">
        <img src="/img/logo.png">
    </div>

    <div class="titulo-navbar">
        Resumen del Pedido
    </div>

    <div style="width:140px;"></div>

</div>

<div class="container">

    <h2>Datos de Entrega</h2>

    <form
action="/compra"
method="POST"
onsubmit="return validarCheckout()"
novalidate
>

        <input
type="text"
id="nombre"
name="nombre"
placeholder="Nombre completo"
>

<small id="errNombre"></small>

        <input
type="email"
id="correo"
name="correo"
placeholder="Correo electrónico"
>

<small id="errCorreo"></small>
        <input
type="text"
id="telefono"
name="telefono"
placeholder="Teléfono"
maxlength="8"
>

<small id="errTelefono"></small>

        <input
type="text"
id="direccion"
name="direccion"
placeholder="Dirección exacta"
>

<small id="errDireccion"></small>

        <select
id="envio"
name="envio"
>

     <option value="" selected disabled>
        Seleccione destino
    </option>      

    <option value="juticalpa">
        Mandadito Juticalpa (L.60)
    </option>

    <option value="jutiquile">
        Mandadito Jutiquile (L.80)
    </option>

    <option value="catacamas">
        Mandadito Catacamas (L.120)
    </option>
</select>
<small id="errEnvio"></small>

<div id="resumen-total"
style="
background:#f8f9fa;
padding:15px;
border-radius:8px;
margin:10px 0;
">

    <p>
        Subtotal:
        <strong>L. <%= total %></strong>
    </p>

  <p>
    Envío:
    <strong id="costo-envio">Seleccione destino</strong>
</p>

<p>
    Total estimado:
    <strong id="total-estimado">
        L. <%= total %>
    </strong>
</p>

</div>

        <select
id="metodo"
name="metodo"
>

<option value="" selected disabled>
Seleccione método de pago
</option>

<option value="contra_entrega">
Pago contra entrega
</option>

<option value="transferencia">
Transferencia bancaria
</option>

</select>
        <small id="errMetodo"></small>

        <button
type="submit"
class="btn-pagar"
>
Confirmar pedido
</button>
    </form>

</div>
<script>

const envio = document.querySelector('select[name="envio"]');

const subtotal = <%= total %>;

envio.addEventListener('change', () => {

    let costo = 0;

    if(envio.value === "juticalpa"){
        costo = 60;
    }

    if(envio.value === "jutiquile"){
        costo = 80;
    }

    if(envio.value === "catacamas"){
        costo = 120;
    }

    document.getElementById("costo-envio").innerText =
        "L. " + costo;

    document.getElementById("total-estimado").innerText =
        "L. " + (subtotal + costo);

});

function validarCheckout(){

let ok = true;

document.getElementById("errNombre").innerHTML="";
document.getElementById("errCorreo").innerHTML="";
document.getElementById("errTelefono").innerHTML="";
document.getElementById("errDireccion").innerHTML="";
document.getElementById("errEnvio").innerHTML="";
document.getElementById("errMetodo").innerHTML="";

const nombre =
document.getElementById("nombre").value.trim();

const correo =
document.getElementById("correo").value.trim();

const telefono =
document.getElementById("telefono").value.trim();

const direccion =
document.getElementById("direccion").value.trim();

const envio =
document.getElementById("envio").value;

const metodo =
document.getElementById("metodo").value;

if(nombre === ""){
document.getElementById("errNombre").innerHTML =
"Ingrese nombre completo";
ok = false;
}
else if(nombre.length < 3){
document.getElementById("errNombre").innerHTML =
"El nombre debe tener al menos 3 caracteres";
ok = false;
}

if(correo === ""){
document.getElementById("errCorreo").innerHTML =
"Ingrese correo";
ok = false;
}
else{

const patronCorreo =
/^[^\s@]+@[^\s@]+\.[^\s@]+$/;

if(!patronCorreo.test(correo)){

document.getElementById("errCorreo").innerHTML =
"Ingrese un correo válido";

ok = false;

}

}

if(telefono === ""){
document.getElementById("errTelefono").innerHTML =
"Ingrese teléfono";
ok = false;
}
else if(!/^\d{8}$/.test(telefono)){
document.getElementById("errTelefono").innerHTML =
"El teléfono debe contener exactamente 8 dígitos";
ok = false;
}

if(direccion === ""){
document.getElementById("errDireccion").innerHTML =
"Ingrese dirección";
ok = false;
}

if(envio === ""){
document.getElementById("errEnvio").innerHTML =
"Seleccione destino";
ok = false;
}

if(metodo === ""){
document.getElementById("errMetodo").innerHTML =
"Seleccione método de pago";
ok = false;
}

return ok;

}
</script>
</body>
</html>
