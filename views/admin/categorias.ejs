<!DOCTYPE html>
<html>
<head>
    <title>Categorías</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">

<style>
    body {
        font-family: Arial;
        margin: 0;
        background: #f4f4f4;
    }

    .navbar{
    display:flex;
    align-items:center;
    justify-content:center;

    background:#111;
    color:white;

    padding:8px 20px;

    position:relative;
}

.logo{
    position:absolute;
    left:20px;
}

.logo img{
    height:40px;
}

.titulo-navbar{
    font-size:18px;
    font-weight:bold;
}

    /* SISTEMA DE BOTONES (Código de colores funcional) */
    button {
        padding: 8px 12px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-add{
    background:#050527;
    color:white;
}

    .btn-edit{
    background:#4b5563;
    color:white;
}

    .btn-delete{
    background:#374151;
    color:white;
}

    /* GRID DE CATEGORÍAS */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 15px;
    }

    .card {
        background: white;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.1);
    }

    .card h3 {
        margin: 0;
    }

    .actions {
        margin-top: 10px;
    }
</style>
</head>

<body>

<div class="navbar">

    <div class="logo">
        <img src="/img/logo.png">
    </div>

    <div class="titulo-navbar">
        Gestión de Categorías
    </div>

</div>

<a href="/admin" style="
    display:inline-block;
    margin:15px;
    padding:8px 15px;
    background:black;
    color:white;
    text-decoration:none;
    border-radius:6px;
    ">
    ← Volver al Panel
</a>

<div class="container">

    <!-- MENSAJE -->
    <% if (mensaje) { %>
        <div style="
        background: #16a34a;
        color: white;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
        text-align:center;
        ">
        <%= mensaje %>
        </div>
    <% } %>

    <!-- FORM -->
    <div class="form-box">
        <form action="/admin/categorias/agregar" method="POST">
            <input type="text" name="nombre" placeholder="Nombre" required>
            <input type="text" name="descripcion" placeholder="Descripción" required>
            <button type="submit" class="btn-add">Agregar</button>
        </form>
    </div>

    <!-- LISTA -->
    <div class="grid">
        <% categorias.forEach(c => { %>
            <div class="card">
                <h3><%= c.nombre %></h3>
                <p><%= c.descripcion %></p>

                <div class="actions">

                    <a href="/admin/categorias/editar/<%= c.id %>" class="btn-edit">
                    Editar
                    </a>

                    <form action="/admin/categorias/eliminar" method="POST" style="display:inline;">
                        <input type="hidden" name="id" value="<%= c.id %>">
                        <button type="submit" class="btn-delete">Eliminar</button>
                    </form>

                </div>
            </div>
        <% }) %>
    </div>

</div>

</body>
</html>
