<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sico's - Carrito</title>
<link rel="icon" type="image/png" href="/img/favicon.png">
<style>
body {
    font-family: 'Segoe UI', sans-serif;
    margin: 0;
    background: #f5f5f5;
}

/* NAVBAR Barra superior con diseño flexible (Flexbox) */
.navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 20px;
    background: #111;
    color: white;
    flex-wrap: wrap; /* Permite que los elementos bajen si no hay espacio */
}

.logo img {
    height: 45px;
    width: auto;
}

.nav-links {
    display: flex;
    flex-wrap: wrap;
    margin-left: auto;
    margin-right:40px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    font-size: 16px;
    margin-left:25px;
}

.slogan{
    font-size: 28px;
    font-weight: bold;
}

/* ICONO CARRITO */
.carrito {
    font-weight: bold;
    font-size: 16px;
    margin-left: 25px;
}

/* CONTENEDOR PRINCIPAL: Centra el contenido y limita el ancho para lectura cómoda */
.container {
    padding: 20px;
    max-width: 800px;
    margin: auto;
}

/* TARJETAS DE PRODUCTO: Estilo "Card" para cada ítem seleccionado */
.card {
    background: white;
    padding: 15px;
    margin-bottom: 15px;
    border-radius: 10px;
}

/* BOTONES DE ACCIÓN: Colores semánticos (Rojo para eliminar, Verde para pagar) */
.btn-eliminar {
    background:#050527;
    color: white;
    border: none;
    padding: 6px 10px;
    border-radius: 5px;
    cursor: pointer;
}

/* TOTAL */
.total-box {
    text-align: center;
    margin-top: 20px;
}

.btn-pagar {
    padding: 12px 20px;
    background: #16a34a;
    color: white;
    border-radius: 8px;
    border: none;
    cursor: pointer;
}

/* BOTÓN VOLVER */
.btn-volver {
    display:inline-block;
    margin-top:15px;
    padding:8px 15px;
    background:black;
    color:white;
    text-decoration:none;
    border-radius:6px;
}

/* MEDIA QUERIES: Ajustes automáticos para pantallas pequeñas (Celulares) */
@media (max-width: 768px) {

    .navbar {
        flex-direction: column;
        align-items: flex-start;
    }

    .container {
        padding: 15px;
    }

    .card {
        padding: 12px;
    }

    .btn-pagar {
        width: 100%;
    }
}

/* FIX PARA QUE NO SE VEA PEQUEÑO */
html, body {
    width: 100%;
    overflow-x: hidden;
}

/* PARA EVITAR QUE EL CONTENIDO SE ENCOJA */
.container {
    width: 100%;
    box-sizing: border-box;
}
</style>
</head>

<body>

<div class="navbar">

    <div class="logo">
        <img src="/img/logo.png">
    </div>

    <div class="slogan">
        Tecnología a tu alcance
    </div>

    <div class="nav-links">
    <a href="/inicio">Inicio</a>
    <a href="/productos">Productos</a>
</div>

<div class="carrito">
    Carrito: <%= carritoCount %>
</div>

</div>

<div class="container">

<% if (productos.length === 0) { %>

    <p style="text-align:center;">Tu carrito está vacío 🛒</p>

<% } else { %>

<% productos.forEach(p => { %>
<div class="card">

    <h3><%= p.nombre %></h3>

    <p>Cantidad: <strong><%= p.cantidad %></strong></p>

    <p>Precio unitario: L. <%= p.precio %></p>

    <p>
        Subtotal:
        <strong>L. <%= p.precio * p.cantidad %></strong>
    </p>

    <form action="/carrito/eliminar" method="POST">
        <input type="hidden" name="id" value="<%= p.id %>">
        <button class="btn-eliminar"> Eliminar</button>
    </form>

</div>
<% }) %>

<div class="total-box">
    <h2>Total: L. <%= total %></h2>

    <a href="/checkout">
        <button class="btn-pagar">Confirmar pedido</button>
    </a>
</div>

<% } %>

</div>

</body>
</html>