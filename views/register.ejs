<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro</title>
    <style>
        /* ESTILO DE FONDO ESTRUCTURAL */
        body {
    font-family: Arial;
    margin: 0;
    background: url('/img/tienda.jpg') no-repeat center center/cover;
    height: 100vh;

    display:flex;
    justify-content:center;
    align-items:center;
}

        /* CONTENEDOR DEL FORMULARIO (Card) */
    .container{
    background:#fff;
    padding:40px;
    border-radius:15px;
    width:300px;
    text-align:center;
}

        /* CAMPOS DE ENTRADA */
        input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border-radius: 8px;
            border: 1px solid #ccc;
        }

        /* BOTÓN DE ACCIÓN (Verde para indicar creación/positivo) */
        button {
            width: 100%;
            padding: 10px;
            background: #38a169;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        button:hover {
            background: #2f855a;
        }

        a {
            display: block;
            margin-top: 15px;
            text-decoration: none;
            color: #333;
        }

        .password-box{
position:relative;
}

.password-box input{
width:100%;
box-sizing:border-box;
}

.password-box span{
position:absolute;
right:15px;
top:50%;
transform:translateY(-50%);
cursor:pointer;
}

small{
display:block;
color:red;
margin-top:5px;
font-size:13px;
}
</style>
</head>
<body>

<div class="container">
    <h2>Crear Cuenta</h2>
    <% if (typeof error !== 'undefined') { %>

<div style="
background:#dc2626;
color:white;
padding:10px;
border-radius:8px;
margin-bottom:10px;
">
<%= error %>
</div>

<% } %>

    <!--REGISTRARSE -->
    <form
action="/auth/register"
method="POST"
onsubmit="return validarRegistro()"
novalidate
>

<input
type="text"
id="nombre"
name="nombre"
placeholder="Nombre"
autocomplete="off">

<small id="errNombre"></small>

<input
type="email"
id="correo"
name="correo"
placeholder="Correo"
autocomplete="off">

<small id="errCorreo"></small>

<div class="password-box">

<input
type="password"
name="password"
id="password">

<small id="errPass"></small>

<span onclick="togglePassword()">
👁
</span>

</div>
        <button type="submit">Registrarse</button>
    </form>
    <a href="/admin/login">Volver al login</a>
</div>


<script>

function togglePassword(){

const input=
document.getElementById("password");

input.type=
input.type==="password"
?
"text"
:
"password";

}

</script>
<script>

function validarRegistro(){

let ok=true;

document.getElementById("errNombre").innerHTML="";
document.getElementById("errCorreo").innerHTML="";
document.getElementById("errPass").innerHTML="";

const nombre =
document.getElementById("nombre").value.trim();

const correo =
document.getElementById("correo").value.trim();

const pass =
document.getElementById("password").value;

if(nombre===""){
document.getElementById("errNombre").innerHTML="Ingrese nombre";
ok=false;
}

if(correo===""){
document.getElementById("errCorreo").innerHTML="Ingrese correo";
ok=false;
}

if(pass.length<6){
document.getElementById("errPass").innerHTML="Mínimo 6 caracteres";
ok=false;
}

return ok;

}

</script>
</body>
</html>
