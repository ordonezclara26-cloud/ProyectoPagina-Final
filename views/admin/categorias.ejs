<!DOCTYPE html>
<html>
<head>
    <title>Categorías</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">

<style>
    body {
        font-family: Arial;
        margin: 0;
        background: #f4f4f4;
    }

    .navbar{
    display:flex;
    align-items:center;
    justify-content:space-between;

    background:#111;
    color:white;

    padding:8px 25px;
}

.logo img{
    height:45px;
    width:auto;
}

.titulo-navbar{
    font-size:22px;
    font-weight:700;
}

    /* SISTEMA DE BOTONES (Código de colores funcional) */
    button {
        padding: 8px 12px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-add{
    background:#050527;
    color:white;
}

    .btn-edit{
    background:#050527;
    color:white;

    padding:8px 12px;
    border-radius:5px;

    text-decoration:none;
    display:inline-block;
}

.btn-delete{
    background:#050527;
    color:white;
    padding:8px 12px;
    border-radius:5px;
    text-decoration:none;
    display:inline-flex;
    align-items:center;
    justify-content:center;
}

.actions{
    display:flex;
    align-items:center;
    gap:8px;
    margin-top:15px;
}

    /* GRID DE CATEGORÍAS */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 15px;
    }

    .card {
        background: white;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.1);
    }

    .card h3 {
        margin: 0;
    }

    .form-box{
    background:white;
    padding:20px;
    border-radius:12px;
    margin-bottom:25px;
    box-shadow:0 3px 10px rgba(0,0,0,.08);
}

input{
    padding:10px;
    border:1px solid #d1d5db;
    border-radius:8px;
    margin-right:8px;
}
    .container{
    padding:30px;
}

.form-box form{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

small{
display:block;
color:red;
font-size:13px;
margin-top:4px;
min-height:18px;
}

.form-box form div{
    display:flex;
    flex-direction:column;
}
</style>
</head>

<body>

<div class="navbar">

    <div class="logo">
        <img src="/img/logo.png">
    </div>

    <div class="titulo-navbar">
        Gestión de Categorías
    </div>

    <div style="width:100px;"></div>

</div>

<a href="/admin" style="
display:inline-block;
margin:30px 30px 15px 30px;
padding:8px 15px;
background:black;
color:white;
text-decoration:none;
border-radius:6px;
">
← Volver al Panel
</a>

<div class="container">

    <!-- MENSAJE -->
    <% if (mensaje) { %>
        <div style="
        background: #16a34a;
        color: white;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
        text-align:center;
        ">
        <%= mensaje %>
        </div>
    <% } %>

    <% if (error) { %>
<div style="
background:#dc2626;
color:white;
padding:10px;
margin-bottom:15px;
border-radius:8px;
text-align:center;
">
<%= error %>
</div>
<% } %>

    <!-- FORM -->
    <div class="form-box">

<% if(categoriaEditar){ %>

<form
action="/admin/categorias/editar"
method="POST"
onsubmit="return validarCategoriaEditar()"
novalidate
>

    <input
        type="hidden"
        name="id"
        value="<%= categoriaEditar.id %>"
    >

    <div>

<input
type="text"
id="nombreEditar"
name="nombre"
value="<%= categoriaEditar.nombre %>"
maxlength="50"
>

<small id="errNombreEditar"></small>

</div>

<div>

<input
type="text"
id="descripcionEditar"
name="descripcion"
value="<%= categoriaEditar.descripcion %>"
maxlength="150"
>

<small id="errDescripcionEditar"></small>

</div>

    <button type="submit" class="btn-edit">
        Guardar
    </button>

    <a
        href="/admin/categorias"
        class="btn-delete"
        style="text-decoration:none;"
    >
        Cancelar
    </a>

</form>

<% } else { %>

<form
action="/admin/categorias/agregar"
method="POST"
onsubmit="return validarCategoria()"
novalidate
>

    <div>
<input
type="text"
id="nombre"
name="nombre"
placeholder="Nombre"
maxlength="50"
>

<small id="errNombre"></small>
</div>

<div>
<input
type="text"
id="descripcion"
name="descripcion"
placeholder="Descripción"
maxlength="150"
>

<small id="errDescripcion"></small>
</div>

    <button type="submit" class="btn-add">
        Agregar
    </button>

</form>

<% } %>

</div>

    <!-- LISTA -->
    <div class="grid">
        <% categorias.forEach(c => { %>
            <div class="card">
                <h3><%= c.nombre %></h3>
                <p><%= c.descripcion %></p>

                <div class="actions">

                    <a href="/admin/categorias?editar=<%= c.id %>"
   class="btn-edit">
                    Editar
                    </a>

                    <form action="/admin/categorias/eliminar"
      method="POST">
                        <input type="hidden" name="id" value="<%= c.id %>">
                        <button type="submit" class="btn-delete">Eliminar</button>
                    </form>

                </div>
            </div>
        <% }) %>
    </div>

</div>
<script>

function validarCategoria(){

let ok = true;

document.getElementById("errNombre").innerHTML = "";
document.getElementById("errDescripcion").innerHTML = "";

const nombre =
document.getElementById("nombre").value.trim();

const descripcion =
document.getElementById("descripcion").value.trim();

if(nombre === ""){

document.getElementById("errNombre").innerHTML =
"Ingrese nombre";

ok = false;

}
else if(nombre.length < 3){

document.getElementById("errNombre").innerHTML =
"El nombre debe tener al menos 3 caracteres";

ok = false;

}

if(descripcion === ""){

document.getElementById("errDescripcion").innerHTML =
"Ingrese descripción";

ok = false;

}
else if(descripcion.length < 5){

document.getElementById("errDescripcion").innerHTML =
"La descripción debe tener al menos 5 caracteres";

ok = false;

}

return ok;

}

function validarCategoriaEditar(){

let ok = true;

document.getElementById("errNombreEditar").innerHTML = "";
document.getElementById("errDescripcionEditar").innerHTML = "";

const nombre =
document.getElementById("nombreEditar").value.trim();

const descripcion =
document.getElementById("descripcionEditar").value.trim();

if(nombre === ""){

document.getElementById("errNombreEditar").innerHTML =
"Ingrese nombre";

ok = false;

}
else if(nombre.length < 3){

document.getElementById("errNombreEditar").innerHTML =
"El nombre debe tener al menos 3 caracteres";

ok = false;

}

if(descripcion === ""){

document.getElementById("errDescripcionEditar").innerHTML =
"Ingrese descripción";

ok = false;

}
else if(descripcion.length < 5){

document.getElementById("errDescripcionEditar").innerHTML =
"La descripción debe tener al menos 5 caracteres";

ok = false;

}

return ok;

}
</script>
</body>
</html>
