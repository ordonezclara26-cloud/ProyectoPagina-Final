<!DOCTYPE html>
<html>
<head>
<title>Usuarios</title>
<link rel="icon" type="image/png" href="/img/favicon.png">

<style>
body {
    font-family: 'Segoe UI', sans-serif;
    background: #f4f6f9;
    margin: 0;
}

/* NAVBAR */
.navbar{
    display:flex;
    align-items:center;
    justify-content:space-between;

    background:#111;
    color:white;

    padding:8px 25px;
}

.logo img{
    height:45px;
    width:auto;
}

.titulo-navbar{
    font-size:22px;
    font-weight:700;
}

/* BOTÓN VOLVER */
.volver {
    display:inline-block;
    margin:15px;
    padding:8px 15px;
    background:black;
    color:white;
    text-decoration:none;
    border-radius:6px;
}

/* CONTENEDOR */
.container {
    padding: 20px;
}

.header-usuarios{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.btn-nuevo{
    background:black;
    color:white;
    text-decoration:none;
    padding:10px 18px;
    border-radius:6px;
    font-weight:600;
    transition:.3s;
}

.btn-nuevo:hover{
    background:#333;
}

/* CARD */
.card {
    background: white;
    padding: 15px;
    margin: 10px 0;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

/* BOTONES */
button {
    margin-top: 5px;
    padding: 6px 10px;
    background: #333;
    color: white;
    border: none;
    border-radius: 5px;
}

.modal{
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;

    background:rgba(0,0,0,.5);

    justify-content:center;
    align-items:center;

    z-index:9999;
}

.modal-box{
    background:white;
    padding:25px;
    border-radius:10px;
    text-align:center;
    min-width:300px;
}

.modal-box p{
    margin-bottom:20px;
    font-size:16px;
}

.modal-box button{
    margin:0 5px;
}
</style>

</head>

<body>

<!-- BARRA -->
<div class="navbar">

    <div class="logo">
        <img src="/img/logo.png">
    </div>

    <div class="titulo-navbar">
        Gestión de Usuarios
    </div>

    <div style="width:100px;"></div>

</div>

<!-- VOLVER -->
<a href="/admin" class="volver">← Volver al Panel</a>

<div class="container">

<% if (mensaje) { %>
<div style="
background: #16a34a;
color: white;
padding: 10px;
margin-bottom: 15px;
border-radius: 8px;
text-align:center;
">
    <%= mensaje %>
</div>
<% } %>

<div class="header-usuarios">

    <h2>Usuarios registrados</h2>

    <a href="/register" class="btn-nuevo">
        + Nuevo Usuario
    </a>

</div>

<% usuarios.forEach(u => { %>
    <div class="card">

        <strong><%= u.nombre %></strong> - <%= u.correo %><br>

        Estado: 
        <%= u.estado == 1 ? "Activo " : "Bloqueado " %>

        <br><br>

       <form
action="/admin/usuarios/bloquear"
method="POST"
class="formBloquear"
>
            <input type="hidden" name="id" value="<%= u.id %>">
            <button type="submit">Bloquear</button>
        </form>

        <form
action="/admin/usuarios/activar"
method="POST"
class="formActivar"
>
            <input type="hidden" name="id" value="<%= u.id %>">
            <button type="submit">Activar</button>
        </form>

        <form
action="/admin/usuarios/eliminar"
method="POST"
class="formEliminar"
>
    <input type="hidden" name="id" value="<%= u.id %>">
    <button type="submit">Eliminar</button>
</form>

    </div>
<% }) %>

</div>
<script>
let formularioActual = null;

document.querySelectorAll(".formBloquear")
.forEach(form => {

    form.addEventListener("submit", function(e){

        e.preventDefault();

        formularioActual = this;

        document.getElementById("textoModal").innerHTML =
        "¿Desea bloquear este usuario?";

        document.getElementById("modalConfirmacion").style.display =
        "flex";

    });

});

document.querySelectorAll(".formActivar")
.forEach(form => {

    form.addEventListener("submit", function(e){

        e.preventDefault();

        formularioActual = this;

        document.getElementById("textoModal").innerHTML =
        "¿Desea activar este usuario?";

        document.getElementById("modalConfirmacion").style.display =
        "flex";

    });

});

document.querySelectorAll(".formEliminar")
.forEach(form => {

    form.addEventListener("submit", function(e){

        e.preventDefault();

        formularioActual = this;

        document.getElementById("textoModal").innerHTML =
        "¿Desea eliminar este usuario?";

        document.getElementById("modalConfirmacion").style.display =
        "flex";

    });

});

function aceptarAccion(){

    formularioActual.submit();

}

function cerrarModal(){

    document.getElementById("modalConfirmacion").style.display =
    "none";

}
</script>
<div id="modalConfirmacion" class="modal">

    <div class="modal-box">

        <p id="textoModal"></p>

        <button type="button" onclick="aceptarAccion()">
            Aceptar
        </button>

        <button type="button" onclick="cerrarModal()">
            Cancelar
        </button>

    </div>

</div>
</body>
</html>