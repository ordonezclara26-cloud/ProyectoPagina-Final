<!DOCTYPE html>
<html>
<head>
<title>Usuarios</title>
<link rel="icon" type="image/png" href="/img/favicon.png">

<style>
body {
    font-family: 'Segoe UI', sans-serif;
    background: #f4f6f9;
    margin: 0;
}

/* NAVBAR */
.navbar{
    display:flex;
    align-items:center;
    justify-content:space-between;

    background:#111;
    color:white;

    padding:8px 25px;
}

.logo img{
    height:45px;
    width:auto;
}

.titulo-navbar{
    font-size:22px;
    font-weight:700;
}

/* BOTÓN VOLVER */
.volver {
    display:inline-block;
    margin:15px;
    padding:8px 15px;
    background:black;
    color:white;
    text-decoration:none;
    border-radius:6px;
}

/* CONTENEDOR */
.container {
    padding: 20px;
}

/* CARD */
.card {
    background: white;
    padding: 15px;
    margin: 10px 0;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

/* BOTONES */
button {
    margin-top: 5px;
    padding: 6px 10px;
    background: #333;
    color: white;
    border: none;
    border-radius: 5px;
}
</style>

</head>

<body>

<!-- BARRA -->
<div class="navbar">

    <div class="logo">
        <img src="/img/logo.png">
    </div>

    <div class="titulo-navbar">
        Gestión de Usuarios
    </div>

    <div style="width:100px;"></div>

</div>

<!-- VOLVER -->
<a href="/admin" class="volver">← Volver al Panel</a>

<div class="container">

<% if (mensaje) { %>
<div style="
background: #16a34a;
color: white;
padding: 10px;
margin-bottom: 15px;
border-radius: 8px;
text-align:center;
">
    <%= mensaje %>
</div>
<% } %>

<h2>Usuarios registrados</h2>

<% usuarios.forEach(u => { %>
    <div class="card">

        <strong><%= u.nombre %></strong> - <%= u.correo %><br>

        Estado: 
        <%= u.estado == 1 ? "Activo " : "Bloqueado " %>

        <br><br>

        <form
action="/admin/usuarios/bloquear"
method="POST"
onsubmit="return confirmarBloqueo()"
>
            <input type="hidden" name="id" value="<%= u.id %>">
            <button>Bloquear</button>
        </form>

        <form
action="/admin/usuarios/activar"
method="POST"
onsubmit="return confirmarActivacion()"
>
            <input type="hidden" name="id" value="<%= u.id %>">
            <button>Activar</button>
        </form>

    </div>
<% }) %>

</div>
<script>

function confirmarBloqueo(){

return confirm(
"¿Desea bloquear este usuario?"
);

}

function confirmarActivacion(){

return confirm(
"¿Desea activar este usuario?"
);

}

</script>
</body>
</html>